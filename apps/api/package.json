{
  "name": "@localfinance/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "dev": "pnpm --filter @localfinance/shared build && prisma generate && tsc -p tsconfig.build.json && node dist/main.js",
    "start": "node dist/main.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node dist/seed.js",
    "test": "node --test test/e2e.test.mjs"
  },
  "dependencies": {
    "@localfinance/shared": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.7",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "prisma": "6.19.3",
    "typescript": "5.9.3"
  }
}
