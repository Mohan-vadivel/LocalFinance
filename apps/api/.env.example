DATABASE_URL=postgresql://postgres:postgres@localhost:5432/localfinance
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=./uploads
# Super Admin created by the seed script
SUPER_ADMIN_PHONE=9000000000
SUPER_ADMIN_PASSWORD=ChangeMe@123
# SMS: "log" (default, writes to the notifications table only) or "msg91"
SMS_PROVIDER=log
MSG91_AUTH_KEY=
MSG91_SENDER=
# AI features that use Claude (ask in plain words, AI briefing, ID card reading, reminder drafts).
# Leave empty to keep them off; each business must also turn them on in Settings > AI features.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
