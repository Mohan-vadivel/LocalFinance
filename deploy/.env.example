# Copy to deploy/.env and fill in. Both names must point (DNS A record) to this server's IP.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# Database password: make it long and random
POSTGRES_PASSWORD=change-me

# At least 32 random characters, e.g. from: openssl rand -hex 32
JWT_SECRET=change-me

# Super Admin created on first start. Change the password after the first login.
SUPER_ADMIN_PHONE=9000000000
SUPER_ADMIN_PASSWORD=ChangeMe@123

# SMS: "log" only records messages; "msg91" sends them
SMS_PROVIDER=log
MSG91_AUTH_KEY=
MSG91_SENDER=
