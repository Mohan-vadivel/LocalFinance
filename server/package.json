{
  "name": "smartfinora-api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "prisma generate && prisma db push && node dist/seed.js",
    "start": "node dist/main.js",
    "service": "node install-service.cjs",
    "restart": "systemctl restart smartfinora-api",
    "logs": "journalctl -u smartfinora-api -n 50 --no-pager",
    "check": "node check.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@localfinance/shared": "file:./vendor/shared",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.7",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76",
    "prisma": "6.19.3"
  }
}
